# Incident Zero - Groq LLM Configuration
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# Optional Access Token protection for cloud APIs
APP_ACCESS_TOKEN=

# Cloud persistence. Provision Upstash Redis through the Vercel Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Real investigation: ONLY externally reachable, read-only telemetry endpoints.
PROMETHEUS_URL=
JAEGER_URL=
OPENSEARCH_URL=
OPENSEARCH_INDEX=otel-logs-*
TELEMETRY_BEARER_TOKEN=

# Exact organiser Action API contract must be supplied before enabling.
ACTION_API_URL=
ACTION_API_TOKEN=
ACTION_API_MAPPING_JSON=

# Optional: set true to disable ALL real actions independent of approval.
KILL_SWITCH=true
